# --- Gradle ---
.gradle/
build/
out/
bin/
!gradle/wrapper/gradle-wrapper.jar

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
*.launch

# --- 运行目录 ---
run/
runs/
repo/

# --- 系统 ---
.DS_Store
Thumbs.db
desktop.ini

# --- 本地路径覆盖（含本机 mods 目录的绝对路径，绝不能提交）---
# gradle.properties 在仓库里保持 local_jar 为空；
# 本地开发把实际路径写进 gradle.local.properties，它不被跟踪。
gradle.local.properties

# --- 日志 ---
*.log
logs/
crash-reports/

# --- 版本存档 ---
# dist/ 里的 jar 是要随版本一起留档并同步到 GitHub 的，故意不忽略。
# 只忽略基线快照这种本地判断用的中间文件。
dist/.baseline/
